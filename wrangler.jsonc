// Cloudflare Workers config. The site is a Next.js static export (out/) served by Workers static assets: page and
// file requests never run code and don't count towards the free plan's 100,000 Worker requests a day. The Worker
// (worker/index.ts) runs only for /api/*. Nothing here creates account resources: no R2, KV, D1, Durable Objects,
// Images binding or image transformations. The one binding is FORM_LIMITER, a free rate limit counter.
// Runtime secret: SEQUENZY_API_KEY (`npx wrangler secret put SEQUENZY_API_KEY` or the dashboard, never here).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name only: it is the *.workers.dev subdomain and the dashboard label, not the brand (see README, "Renaming").
  "name": "closedlogic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // process.env for app/site.config.ts, which the Worker imports for the brand facts
    "nodejs_compat",
    // fetch() in the Worker can only reach public addresses (the form API calls api.sequenzy.com)
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    // /pricing serves out/pricing.html; /pricing.html and /pricing/ redirect to /pricing
    "html_handling": "auto-trailing-slash",
    // unknown paths get out/404.html with a 404 status, still without running the Worker
    "not_found_handling": "404-page",
    // the paths that need code: the contact form, and byte ranges for the unlisted video files (worker/index.ts)
    "run_worker_first": ["/api/*", "/v/*.mp4"]
  },
  // Declares the runtime secret so the dashboard and wrangler agree on it. The value is set in the dashboard or with
  // `wrangler secret put` and never lives in this file.
  // No plain-text variables: everything sensitive is a secret. Declared empty so the dashboard and this file agree,
  // and a variable added in the dashboard by mistake is removed on the next deploy.
  "vars": {},
  // Contact form rate limit (worker/index.ts): 5 posts per IP per 60 seconds in each Cloudflare location, then 429.
  // Workers Rate Limiting is included on the free plan and creates no billable resource. namespace_id is any
  // integer unique within the account.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "secrets": { "required": ["SEQUENZY_API_KEY"] },
  "observability": { "enabled": true }
}
